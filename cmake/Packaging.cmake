if(NOT PROJECT_IS_TOP_LEVEL)
    return()
endif()

set(VIBEPLAYER_PACKAGE_VERSION "${PROJECT_VERSION}" CACHE STRING
    "Numeric version embedded in native installer metadata"
)
if(NOT VIBEPLAYER_PACKAGE_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
    message(FATAL_ERROR
        "VIBEPLAYER_PACKAGE_VERSION must use the numeric major.minor.patch form"
    )
endif()
string(REPLACE "." ";" VIBEPLAYER_PACKAGE_VERSION_PARTS
    "${VIBEPLAYER_PACKAGE_VERSION}"
)
list(GET VIBEPLAYER_PACKAGE_VERSION_PARTS 0 VIBEPLAYER_PACKAGE_VERSION_MAJOR)
list(GET VIBEPLAYER_PACKAGE_VERSION_PARTS 1 VIBEPLAYER_PACKAGE_VERSION_MINOR)
list(GET VIBEPLAYER_PACKAGE_VERSION_PARTS 2 VIBEPLAYER_PACKAGE_VERSION_PATCH)

set(CPACK_PACKAGE_NAME "vibePlayerQT")
set(CPACK_PACKAGE_VENDOR "gjh303987897")
set(CPACK_PACKAGE_CONTACT
    "gjh303987897 <gjh303987897@users.noreply.github.com>"
)
set(CPACK_PACKAGE_HOMEPAGE_URL
    "https://github.com/gjh303987897/vibeEmbyPlayerQT"
)
