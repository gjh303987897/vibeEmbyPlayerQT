set(CPACK_PACKAGE_VERSION "${VIBEPLAYER_PACKAGE_VERSION}")
set(CPACK_PACKAGE_VERSION_MAJOR "${VIBEPLAYER_PACKAGE_VERSION_MAJOR}")
set(CPACK_PACKAGE_VERSION_MINOR "${VIBEPLAYER_PACKAGE_VERSION_MINOR}")
